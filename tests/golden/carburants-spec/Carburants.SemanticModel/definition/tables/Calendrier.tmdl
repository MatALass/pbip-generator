	column 'Jour semaine numéro'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: afba9e83-4bbc-5212-8e76-0cb1ab07f1d7
		summarizeBy: none
		sourceColumn: Jour semaine numéro

		annotation SummarizationSetBy = Automatic

	column 'Jour semaine'
		dataType: string
		lineageTag: 39a36a23-72eb-57f6-8126-46bcbfbc75f8
