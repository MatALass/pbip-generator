table Calendrier
	dataCategory: Time
	lineageTag: adef0db1-bd00-5a24-aa1e-0e9cd66d23c4

	column Date
		dataType: dateTime
		formatString: dd/mm/yyyy
		isKey
		lineageTag: 9446a3a8-fbbe-50ee-9cc9-2adb44845590
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Année'
		dataType: int64
		formatString: 0
		lineageTag: 99cd3e0b-510f-5843-8cb6-265deec199d2
