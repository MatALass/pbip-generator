	column 'Jour semaine numéro'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 4d004af1-ed63-5899-9bed-536976400ef4
		summarizeBy: none
		sourceColumn: Jour semaine numéro

		annotation SummarizationSetBy = Automatic

	column 'Jour semaine'
		dataType: string
		lineageTag: 274b17ff-c69e-5c46-920b-808c3418c526
		summarizeBy: none
		sourceColumn: Jour semaine
		sortByColumn: 'Jour semaine numéro'

		annotation SummarizationSetBy = Automatic

	partition Calendrier = m
		mode: import
		source =
				let
				    StartDate = Date.StartOfYear(List.Min({Date.From(List.Min(Ventes[#"Date commande"])), Date.From(List.Max(Ventes[#"Date commande"])), Date.From(List.Min(Ventes[#"Date livraison"])), Date.From(List.Max(Ventes[#"Date livraison"]))})),
				    EndDate = Date.EndOfYear(List.Max({Date.From(List.Min(Ventes[#"Date commande"])), Date.From(List.Max(Ventes[#"Date commande"])), Date.From(List.Min(Ventes[#"Date livraison"])), Date.From(List.Max(Ventes[#"Date livraison"]))})),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    AsTable = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    Typed = Table.TransformColumnTypes(AsTable, {{"Date", type date}}),
				    AddYear = Table.AddColumn(Typed, "Année", each Date.Year([Date]), Int64.Type),
				    AddQuarter = Table.AddColumn(AddYear, "Trimestre", each "T" & Text.From(Date.QuarterOfYear([Date])), type text),
				    AddMonthNum = Table.AddColumn(AddQuarter, "Mois numéro", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNum, "Mois", each Text.Proper(Date.MonthName([Date], "fr-FR")), type text),
				    AddYearMonth = Table.AddColumn(AddMonth, "Année-Mois", each Text.From(Date.Year([Date])) & "-" & Text.PadStart(Text.From(Date.Month([Date])), 2, "0"), type text),
				    AddDayNum = Table.AddColumn(AddYearMonth, "Jour semaine numéro", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
				    AddDay = Table.AddColumn(AddDayNum, "Jour semaine", each Text.Proper(Date.DayOfWeekName([Date], "fr-FR")), type text)
				in
				    AddDay

	annotation PBI_ResultType = Table
